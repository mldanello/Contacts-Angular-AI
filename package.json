{
  "name": "angular-ai-contacts",
  "version": "1.0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve angular-ai-contacts --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build angular-ai-contacts --configuration production",
    "build:dev": "ng build angular-ai-contacts --configuration development",
    "build:prod": "ng build angular-ai-contacts --configuration production",
    "validate:ui:hashes": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/validate-ui-build.ps1",
    "prepare:ui:package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-ui-package.ps1",
    "zip:ui": "npm run prepare:ui:package && powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path './angular-ui-posix.zip') { Remove-Item './angular-ui-posix.zip' -Force }; tar -a -c -f './angular-ui-posix.zip' -C './dist/angular-ai-contacts/browser' .\"",
    "deploy:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-ui.ps1",
    "deploy:ui:all": "npm run build:prod && npm run validate:ui:hashes && npm run zip:ui && npm run deploy:ui",
    "test": "ng test angular-ai-contacts",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^22.0.5",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/material": "^22.0.3",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-browser-dynamic": "^22.0.5",
    "@angular/router": "^22.0.5",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@types/jasmine": "^6.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "^6.0.0"
  }
}
